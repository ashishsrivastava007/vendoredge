# Copy this file to a new file named exactly ".env" (no .example) and
# fill in your real key below. Never share this file or paste its contents
# anywhere public, including chat messages.

ANTHROPIC_API_KEY=paste-your-real-key-here
# Production app database credentials are supplied by the hosting platform.
# Do not put real DATABASE_URL/MIGRATION_DATABASE_URL values in this file.
DATABASE_URL=postgresql://<app-user>:<app-password>@<db-host>:5432/<db-name>
MIGRATION_DATABASE_URL=postgresql://<migration-user>:<migration-password>@<db-host>:5432/<db-name>
APP_DATABASE_USER=vendoredge_app
APP_DATABASE_PASSWORD=<set-in-hosting-secrets>
# Required for signed workspace sessions. Generate a random 32+ character secret.
VENDOREDGE_AUTH_SECRET=replace-with-a-random-32-plus-character-secret
# Temporary migration bridge for existing ?org=&user= private links.
# Set true only while migrating existing pilot links, then remove/false.
ALLOW_LEGACY_WORKSPACE_LINKS=false
# Internal validation endpoint. Keep false in customer production.
VALIDATION_ENABLED=false

# Optional outbound integration. The application never accepts webhook URLs from users.
# Configure both values on the hosting platform before enabling explicit dispatch.
# VENDOREDGE_WEBHOOK_URL=https://your-approved-integration.example/webhook
# VENDOREDGE_WEBHOOK_SECRET=generate-a-long-random-secret
